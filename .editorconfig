# Consistent encoding and formatting across editors.
# UTF-8 with BOM is required for C# source files: without a BOM, the compiler
# on Windows decodes source code using the system ANSI code page and breaks diacritics.
root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
charset = utf-8-bom

[*.{json,yml,yaml}]
indent_size = 2

[*.{csproj,props,targets}]
indent_size = 2

# Docker and nginx read these files line by line; use LF and no BOM.
[{Dockerfile,Dockerfile.*,*.dockerignore,.dockerignore,compose.yaml,compose.*.yaml,*.conf,*.env}]
charset = utf-8
end_of_line = lf
indent_size = 2

[*.md]
end_of_line = lf
indent_size = 2
